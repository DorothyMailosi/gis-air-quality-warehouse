# Copy to .env and fill in. .env is git-ignored: never commit it.

# PostgreSQL / PostGIS warehouse
AIR_DB_HOST=localhost
AIR_DB_PORT=5433
AIR_DB_NAME=air_polution
AIR_DB_USER=postgres
AIR_DB_PASSWORD=change-me

# Copernicus personal access token (one ECMWF account covers both the
# Atmosphere Data Store for CAMS and the Climate Data Store for ERA5).
# Optional if ~/.cdsapirc has `key:`. CDS_API_KEY only if you use a separate CDS token.
ADS_API_KEY=
CDS_API_KEY=

# Folder holding the DHIS2 health exports named in config/countries/*.yml
# (health.file is relative to this folder). Keep it outside the repository.
GAIA_HEALTH_DATA_DIR=C:/path/to/health-exports
